generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  description String?
  website     String?
  email       String   @unique
  size        String?
  sector      String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
