# ============================================
# .gitignore — Files Git Should Ignore
# ============================================
# Purpose: Prevents committing sensitive data,
#          large files, and build artifacts.
# ============================================

# --- Node.js / JavaScript ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Environment Variables (Sensitive!) ---
.env
.env.local
.env.*.local
.env.production

# --- Build Outputs ---
dist/
build/
out/
*.tsbuildinfo

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- OS Files ---
Thumbs.db
.DS_Store

# --- Testing ---
coverage/
.nyc_output/

# --- Docker ---
*.log
docker-compose.override.yml

# --- Database ---
*.db
*.sqlite
*.sqlite3
prisma/*.db
prisma/dev.db

# --- Temporary Files ---
tmp/
temp/
*.tmp

# --- Backup Files ---
*.bak
*.backup